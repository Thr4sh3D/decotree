<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<title>Christmas Tree Decorating — Mini Game</title>
<style>
  html,body { height:100%; margin:0; }
  body { background:#eaf6ff; /* very light blue - snowy day */ display:flex; align-items:stretch; }
  canvas { display:block; width:100%; height:100%; touch-action: none; }
  .info {
    position: fixed; left:12px; top:12px;
    background: rgba(255,255,255,0.8); padding:8px 10px; border-radius:8px;
    font-family: system-ui, -apple-system, "Segoe UI", Roboto, "Helvetica Neue", Arial;
    font-size:14px; color:#0b3a4a;
    box-shadow:0 2px 8px rgba(0,0,0,0.08);
    user-select:none;
  }
</style>
</head>
<body>
<canvas id="game"></canvas>
<div class="info" id="info">Ornaments on tree: 0</div>
<script>
(() => {
  const canvas = document.getElementById('game');
  const ctx = canvas.getContext('2d', { alpha: false });
  const info = document.getElementById('info');

  let DPR = Math.max(1, window.devicePixelRatio || 1);

  function resizeCanvas() {
    DPR = Math.max(1, window.devicePixelRatio || 1);
    const w = Math.max(300, innerWidth);
    const h = Math.max(300, innerHeight);
    canvas.style.width = w + 'px';
    canvas.style.height = h + 'px';
    canvas.width = Math.round(w * DPR);
    canvas.height = Math.round(h * DPR);
    ctx.setTransform(DPR, 0, 0, DPR, 0, 0);
    computeLayout();
  }

  window.addEventListener('resize', resizeCanvas, { passive: true });

  // Game layout parameters (relative)
  let W=innerWidth, H=innerHeight;
  let cx, cy;
  let tree = { v1:{}, v2:{}, v3:{} , trunk:{} , width:0, height:0 };
  let player = { x:0, y:0, w:80, h:18, color:'#4d2' };
  const ornaments = [];
  const palette = ['#e63946','#ffb703','#fb8500','#8338ec','#3a86ff','#7bd389','#ff6bcb'];

  function computeLayout() {
    W = canvas.clientWidth;
    H = canvas.clientHeight;
    cx = W / 2;
    cy = H / 2.2; // tree is slightly above center
    tree.height = Math.min(H * 0.6, W * 0.6);
    tree.width = tree.height * 0.9;
    tree.v1 = { x: cx, y: cy - tree.height * 0.5 }; // apex
    tree.v2 = { x: cx - tree.width * 0.5, y: cy + tree.height * 0.5 }; // left base
    tree.v3 = { x: cx + tree.width * 0.5, y: cy + tree.height * 0.5 }; // right base
    tree.trunk = {
      x: cx - tree.width * 0.08,
      y: cy + tree.height * 0.5,
      w: tree.width * 0.16,
      h: Math.max(24, tree.height * 0.12)
    };

    player.w = Math.max(48, W * 0.12);
    player.h = Math.max(12, H * 0.03);
    player.y = H - player.h - 24;
    if (!player.x) player.x = cx;
  }

  function clear() {
    ctx.fillStyle = '#eaf6ff';
    ctx.fillRect(0,0,W,H);
  }

  function drawTree() {
    // tree layers for a simple stylized look
    ctx.beginPath();
    ctx.moveTo(tree.v1.x, tree.v1.y);
    ctx.lineTo(tree.v2.x, tree.v2.y);
    ctx.lineTo(tree.v3.x, tree.v3.y);
    ctx.closePath();
    ctx.fillStyle = '#0a8a2f';
    ctx.fill();

    // inner darker triangle to add depth
    ctx.beginPath();
    const inset = Math.min(tree.width, tree.height) * 0.06;
    ctx.moveTo(tree.v1.x, tree.v1.y + inset);
    ctx.lineTo(tree.v2.x + inset, tree.v2.y - inset);
    ctx.lineTo(tree.v3.x - inset, tree.v3.y - inset);
    ctx.closePath();
    ctx.fillStyle = '#0a7a2a';
    ctx.globalAlpha = 0.95;
    ctx.fill();
    ctx.globalAlpha = 1;

    // trunk
    ctx.fillStyle = '#6b3b1b';
    ctx.fillRect(tree.trunk.x, tree.trunk.y, tree.trunk.w, tree.trunk.h);
  }

  function drawPlayer() {
    ctx.fillStyle = '#3b3b3b';
    const px = player.x - player.w/2;
    ctx.fillRect(px, player.y, player.w, player.h);
    // add tiny highlight
    ctx.fillStyle = 'rgba(255,255,255,0.12)';
    ctx.fillRect(px + 6, player.y + 4, Math.max(10, player.w * 0.3), Math.max(4, player.h * 0.4));
  }

  function drawOrnaments() {
    for (const o of ornaments) {
      ctx.beginPath();
      ctx.fillStyle = o.color;
      ctx.arc(o.x, o.y, o.r, 0, Math.PI * 2);
      ctx.fill();

      // small cap/shine
      ctx.beginPath();
      ctx.fillStyle = 'rgba(255,255,255,0.5)';
      ctx.arc(o.x - o.r*0.35, o.y - o.r*0.35, Math.max(1, o.r*0.4), 0, Math.PI*2);
      ctx.fill();
      // hook
      ctx.beginPath();
      ctx.strokeStyle = '#222';
      ctx.lineWidth = Math.max(1, o.r*0.12);
      ctx.moveTo(o.x, o.y - o.r - 1);
      ctx.lineTo(o.x, o.y - o.r - Math.max(4, o.r*0.6));
      ctx.stroke();
    }
  }

  // barycentric / sign method to check if point is inside triangle
  function pointInTriangle(pt, a, b, c) {
    const sign = (p1,p2,p3) => (p1.x - p3.x) * (p2.y - p3.y) - (p2.x - p3.x) * (p1.y - p3.y);
    const d1 = sign(pt, a, b);
    const d2 = sign(pt, b, c);
    const d3 = sign(pt, c, a);
    const hasNeg = (d1 < 0) || (d2 < 0) || (d3 < 0);
    const hasPos = (d1 > 0) || (d2 > 0) || (d3 > 0);
    return !(hasNeg && hasPos);
  }

  function throwOrnament(targetX, targetY) {
    // origin is center top of player rect
    const originX = player.x;
    const originY = player.y;
    const dx = targetX - originX;
    const dy = targetY - originY;
    const len = Math.hypot(dx, dy) || 1;
    // speed tuned for feel
    const speed = Math.max(5, Math.min(20, Math.hypot(W,H) / 80));
    const vx = (dx / len) * speed;
    const vy = (dy / len) * speed;
    const color = palette[Math.floor(Math.random() * palette.length)];
    const r = Math.max(6, Math.min(14, Math.round(Math.min(W,H) / 60 * (0.8 + Math.random()*0.6))));
    ornaments.push({ x: originX, y: originY, vx, vy, r, color, stuck:false });
  }

  // Remove ornaments that fell off-screen far away, but keep stuck ones
  function pruneOrnaments() {
    for (let i = ornaments.length - 1; i >= 0; i--) {
      const o = ornaments[i];
      if (o.stuck) continue;
      if (o.x < -100 || o.x > W + 100 || o.y < -200 || o.y > H + 200) {
        ornaments.splice(i,1);
      }
    }
  }

  // update physics and check collisions
  function update(delta) {
    // delta not used heavily; kept for future-proofing
    for (const o of ornaments) {
      if (o.stuck) continue;
      o.x += o.vx * (delta / 16.67);
      o.y += o.vy * (delta / 16.67);
      // simple check: if center is inside tree triangle, mark stuck
      if (pointInTriangle({x:o.x, y:o.y}, tree.v1, tree.v2, tree.v3)) {
        o.stuck = true;
        // zero velocity
        o.vx = 0; o.vy = 0;
        // optionally nudge outward along vector from tree center to give "stuck on surface" look
        const treeCenter = { x: cx, y: cy + tree.height * 0.06 };
        const nx = o.x - treeCenter.x;
        const ny = o.y - treeCenter.y;
        const nlen = Math.hypot(nx, ny) || 1;
        const push = o.r * 0.2;
        o.x += (nx/nlen) * push;
        o.y += (ny/nlen) * push;
      }
    }
    pruneOrnaments();
  }

  function render() {
    clear();
    drawTree();
    drawOrnaments();
    drawPlayer();
    info.textContent = 'Ornaments on tree: ' + ornaments.filter(o => o.stuck).length;
  }

  // Input handling: coordinates conversion helper
  function toCanvasCoords(clientX, clientY) {
    const rect = canvas.getBoundingClientRect();
    const x = (clientX - rect.left) * (canvas.width / rect.width) / DPR;
    const y = (clientY - rect.top) * (canvas.height / rect.height) / DPR;
    return { x, y };
  }

  // Mouse controls
  let isPointerDown = false;
  window.addEventListener('mousemove', (e) => {
    const p = toCanvasCoords(e.clientX, e.clientY);
    player.x = Math.min(W - player.w/2, Math.max(player.w/2, p.x));
  }, { passive: true });

  window.addEventListener('mousedown', (e) => {
    isPointerDown = true;
    const p = toCanvasCoords(e.clientX, e.clientY);
    throwOrnament(p.x, p.y);
  });

  window.addEventListener('mouseup', () => { isPointerDown = false; });

  // Touch controls
  window.addEventListener('touchstart', (ev) => {
    ev.preventDefault();
    const t = ev.changedTouches[0];
    const p = toCanvasCoords(t.clientX, t.clientY);
    // update player to touch x for better feel
    player.x = Math.min(W - player.w/2, Math.max(player.w/2, p.x));
    throwOrnament(p.x, p.y);
  }, { passive: false });

  window.addEventListener('touchmove', (ev) => {
    ev.preventDefault();
    const t = ev.changedTouches[0];
    const p = toCanvasCoords(t.clientX, t.clientY);
    player.x = Math.min(W - player.w/2, Math.max(player.w/2, p.x));
  }, { passive: false });

  // Keyboard convenience: left/right arrows or A/D for accessibility
  window.addEventListener('keydown', (e) => {
    const step = Math.max(8, W * 0.03);
    if (e.key === 'ArrowLeft' || e.key === 'a') player.x -= step;
    if (e.key === 'ArrowRight' || e.key === 'd') player.x += step;
    player.x = Math.min(W - player.w/2, Math.max(player.w/2, player.x));
    if (e.key === ' ' || e.key === 'Enter') {
      // throw straight up from player
      throwOrnament(player.x, player.y - H*0.25);
    }
  });

  // Game loop
  let last = performance.now();
  function loop(now) {
    const delta = now - last;
    last = now;
    update(delta);
    render();
    requestAnimationFrame(loop);
  }

  // Init
  resizeCanvas();
  computeLayout();
  // place player centered horizontally
  player.x = cx;

  // Start loop
  requestAnimationFrame(loop);

  // For quick testing: pre-seed a few ornaments on the tree
  // (commented out by default)
  // setTimeout(()=>{ throwOrnament(cx - 30, cy); throwOrnament(cx + 30, cy - 40); }, 1000);

})();
</script>
</body>
</html>
